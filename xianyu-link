def _province(t):
    """'四川省' → 'Sichuan' (unknown, e.g. a foreign country → unchanged)."""
    return next((en for zh, en in PROVINCES.items() if t.startswith(zh)), t)


def _ago(t):
    """'10小时前' → '10h ago', '3天前' → '3d ago', '刚刚' → 'just now' (else unchanged)."""
    if t.startswith("刚刚"):
        return "just now"
    m = re.fullmatch(r"(\d+)\s*(秒|分钟|小时|天|周|个月|月|年)前", t)
    if not m:
        return t
    unit = {"秒": "s", "分钟": "min", "小时": "h", "天": "d", "周": "w",
            "个月": " months", "月": " months", "年": "y"}[m.group(2)]
    return f"{m.group(1)}{unit} ago"


def print_details(info, device=False):
    """Compact: 2 lines max under the URL.
       ¥ 2339 (boutique) · published 2026-11-14 10:43 · captured 2026-11-16 22:20:21
       seller https://…  · "matepad mini" #2  · HUAWEI Mate 20 X"""
    a = []
    if "price" in info:
        a.append(f"¥ {info['price']}" + (f" ({info['seller_kind']})" if "seller_kind" in info else ""))
    elif "seller_kind" in info:
        a.append(f"({info['seller_kind']}" + (f": {info['shop_badge']}" if "shop_badge" in info else "") + ")")
    if "positive"  in info: a.append(f"positive {info['positive']}")
    if "on_sale"   in info: a.append(f"on sale {info['on_sale']}")
    elif "items"   in info: a.append(f"{info['items']} items")
    if "sold"      in info: a.append(f"sold (shown) {info['sold']}")
    if "credit"    in info: a.append(f"credit {info['credit']}")
    if "reviews"   in info: a.append(f"reviews {info['reviews']}")
    if "published" in info: a.append(f"published {info['published']}")
    if "seen_at"   in info: a.append(f"captured {info['seen_at'].replace('T', ' ')}")
    b = []
    if "name"      in info: b.append(f"name {info['name']}")
    if "ip"        in info: b.append(f"IP {_province(info['ip'])}")
    if "last_seen" in info: b.append(f"last online {_ago(info['last_seen'])}")
    if "fans"      in info: b.append(f"{info['fans']} fans")
    if "kudos"     in info: b.append(f"{info['kudos']} kudos")
    if info.get("type") == "item" and "seller_url" in info:
        b.append(f"seller {info['seller_url']}")
    if "query" in info:
        b.append(f"\"{info['query']}\"" + (f" #{info['index']}" if "index" in info else ""))
    if device and "device" in info:
        b.append(info["device"].split(" (")[0])
    for parts in (a, b):
        if parts:
            print("         " + "  ·  ".join(parts))
    sys.stdout.flush()


def log_entry(info):
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    entry = {"seen_at": datetime.now().isoformat(timespec="seconds"), **info}
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


def _imgcat(path, width=MAINPIC_WIDTH):
    if shutil.which("wezterm"):
        subprocess.run(["wezterm", "imgcat", "--width", width, path], check=False)
    else:
        data = open(path, "rb").read()
        b64  = base64.b64encode(data).decode()
        sys.stdout.write(f"\033]1337;File=inline=1;width={width};preserveAspectRatio=1:{b64}\a\n")
        sys.stdout.flush()


def _split_halves(src):
    """Split a portrait image in 2 equal halves placed side by side → temp jpg path."""
    from PIL import Image
    img = Image.open(src).convert("RGB")
    cw, ch = img.size
    half = ch // 2
    gap  = 10
    combined = Image.new("RGB", (cw * 2 + gap, half), (255, 255, 255))
    combined.paste(img.crop((0, 0, cw, half)), (0, 0))
    combined.paste(img.crop((0, half, cw, half * 2)), (cw + gap, 0))
    out = os.path.join(TMP_DIR, "xianyu_sc_split.jpg")
    combined.save(out, "JPEG", quality=85)
    return out


def _screenshot_crop(delay=SCREENSHOT_DELAY, item_id=None):
    """Capture the phone screen, crop status/nav bars, save it (unsplit) → path."""
    try:
        if _wait(delay):
            return None   # user left the item: don't capture the next page
        from PIL import Image
        img = None
        for attempt in range(3):
            # Empty capture when the login popup (secure window) is on top → retry
            r = subprocess.run(["adb", "exec-out", "screencap", "-p"],
                               capture_output=True, timeout=10)
            try:
                img = Image.open(io.BytesIO(r.stdout)).convert("RGB")
                break
            except Exception:
                if _wait(1):
                    return None
        if img is None:
            return None
        w, h = img.size
        cropped = img.crop((0, int(h * CROP_TOP / 100), w, int(h * CROP_BOTTOM / 100)))
        if item_id:
            SHOTS_DIR.mkdir(parents=True, exist_ok=True)
            out = str(SHOTS_DIR / f"{item_id}.jpg")
        else:
            out = os.path.join(TMP_DIR, "xianyu_sc_crop.jpg")
        cropped.save(out, "JPEG", quality=85)
        return out
    except Exception:
        return None


def show_mainpic(url):
    try:
        if url.startswith("//"):
            url = "https:" + url
        with urllib.request.urlopen(url, timeout=10) as r:
            data = r.read()
        from PIL import Image
        img = Image.open(io.BytesIO(data)).convert("RGB")
        img.thumbnail((800, 800))
        tmp = os.path.join(TMP_DIR, "xianyu_mainpic.jpg")
        img.save(tmp, "JPEG", quality=85)
        _imgcat(tmp)
    except Exception as e:
        print(f"         (image download failed: {e})", file=sys.stderr)


def show_image(url, allow_screenshot=True, delay=SCREENSHOT_DELAY, item_id=None):
    """Display the item: phone screenshot split in 2 halves side by side.
    Falls back to the CDN mainPic if the screen can't be captured (or already shows another page).
    Returns the saved (unsplit) screenshot path, if any."""
    if not sys.stdout.isatty():
        return None
    if allow_screenshot:
        path = _screenshot_crop(delay, item_id)
        if path:
            try:
                _imgcat(_split_halves(path), SCREENSHOT_WIDTH)
            except Exception:
                _imgcat(path, MAINPIC_WIDTH)
            return path
    if url:
        show_mainpic(url)
    return None


def _load_history():
    try:
        with open(LOG_FILE, encoding="utf-8") as f:
            return [json.loads(l) for l in f if l.strip()]
    except FileNotFoundError:
        die(f"no history yet ({LOG_FILE})")


def show_entry(info, split, copy=True):
    clip = copy_to_clipboard(info["url"]) if copy else None
    clip_note = f"  → copied ({clip})" if clip else ""
    print(f"[{info['type']}]".ljust(9) + f"{info['url']}{clip_note}")
    print_details(info, device=True)
    shot = info.get("screenshot")
    if info["type"] == "seller" and shot and os.path.exists(shot) and sys.stdout.isatty():
        _imgcat(_split_halves(shot), SCREENSHOT_WIDTH) if split else _imgcat(shot, MAINPIC_WIDTH)
    if info["type"] == "item":
        if not sys.stdout.isatty():
            pass   # no inline images when piped
        elif shot and os.path.exists(shot):
            if split:
                _imgcat(_split_halves(shot), SCREENSHOT_WIDTH)
            else:
                _imgcat(shot, MAINPIC_WIDTH)
        elif info.get("image"):
            print("         (no screenshot saved, showing CDN image)")
            show_mainpic(info["image"])
        else:
            print("         (no screenshot saved for this entry)")
    print(flush=True)


def _human(n):
    for unit in ("o", "Ko", "Mo", "Go"):
        if n < 1024 or unit == "Go":
            return f"{n:.0f} {unit}" if unit == "o" else f"{n:.1f} {unit}"
        n /= 1024


def log_stats():
    """→ 'N captures (I items, S sellers, P screenshots) — X Mo' for the startup banner."""
    entries = []
    if LOG_FILE.exists():
        with open(LOG_FILE, encoding="utf-8") as f:
            entries = [json.loads(l) for l in f if l.strip()]
    shots = list(SHOTS_DIR.glob("*.jpg")) if SHOTS_DIR.exists() else []
    size  = (LOG_FILE.stat().st_size if LOG_FILE.exists() else 0) + sum(p.stat().st_size for p in shots)
    items = sum(1 for e in entries if e.get("type") == "item")
    return (f"{len(entries)} captures ({items} items, {len(entries) - items} sellers, "
            f"{len(shots)} screenshots) — {_human(size)} in {LOG_FILE.parent}")


def purge(days=None, yes=False):
    """Delete history entries (all, or older than `days`) and their unreferenced screenshots."""
    from datetime import timedelta
    entries = _load_history() if LOG_FILE.exists() else []
    if days is None:
        keep = []
        what = "ALL history and screenshots"
    else:
        cutoff = (datetime.now() - timedelta(days=days)).isoformat(timespec="seconds")
        keep = [e for e in entries if e.get("seen_at", "") >= cutoff]
        what = f"{len(entries) - len(keep)} entries older than {days} days (+ their screenshots)"
    print(f"Before: {log_stats()}")
    if not yes:
        try:
            if input(f"Delete {what}? [y/N] ").strip().lower() not in ("y", "yes", "o", "oui"):
                print("Cancelled."); return
        except EOFError:
            print("Cancelled."); return
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG_FILE, "w", encoding="utf-8") as f:
        for e in keep:
            f.write(json.dumps(e, ensure_ascii=False) + "\n")
    used = {os.path.abspath(e["screenshot"]) for e in keep if e.get("screenshot")}
    if SHOTS_DIR.exists():
        for shot in SHOTS_DIR.glob("*.jpg"):
            if os.path.abspath(shot) not in used:
                shot.unlink()
    print(f"After:  {log_stats()}")


