def _read_key():
    """One keypress → 'up' / 'down' / 'left' / 'right' / a plain character."""
    if WINDOWS:
        import msvcrt
        c = msvcrt.getwch()
        if c in ("\x00", "\xe0"):
            return {"H": "up", "P": "down", "K": "left", "M": "right"}.get(msvcrt.getwch(), "")
        return c
    import termios, tty
    fd  = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        c = os.read(fd, 1).decode(errors="ignore")
        if c == "\x1b":
            seq = os.read(fd, 2).decode(errors="ignore")
            return {"[A": "up", "[B": "down", "[D": "left", "[C": "right"}.get(seq, "esc")
        return c
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def show_last(n, split):
    """--last N: browse history starting at the Nth most recent entry (0 = latest).
    ↑ = older (N+1), ↓ = newer (N-1), s = split on/off, q = quit.
    In split mode, 2 entries are shown (N, then N+1 below); the URL copied is N's."""
    entries = _load_history()
    if not 0 <= n < len(entries):
        die(f"--last must be between 0 and {len(entries) - 1}")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        show_entry(entries[-1 - n], split)
        return
    try:
        while True:
            sys.stdout.write("\033[2J\033[3J\033[H")   # clear screen + scrollback
            pair = split and n + 1 < len(entries)
            label = f"--last {n}" + (f" + {n + 1}" if pair else "")
            print(f"{label}   ({n + 1}/{len(entries)})\n")
            show_entry(entries[-1 - n], split)
            if pair:
                print("─" * 60 + f"  --last {n + 1}\n")
                show_entry(entries[-2 - n], split, copy=False)
            print(f"↑ older   ↓ newer   s split {'off' if split else 'on'}   q quit", flush=True)
            while True:
                k = _read_key()
                if k in ("q", "Q", "esc", "\x1b", "\x03"):   # \x1b = Esc on Windows (msvcrt)
                    return
                if k == "up" and n < len(entries) - 1:
                    n += 1; break
                if k == "down" and n > 0:
                    n -= 1; break
                if k in ("s", "S"):
                    split = not split; break
    except KeyboardInterrupt:
        pass
    finally:
        print()


_notif = {"id": None, "t": 0.0}
NOTIFY_MIN_INTERVAL = 2   # s between desktop notifications (KDE rate-limits bursts)


def notify(info):
    """Desktop notification. Replaces the previous one (-r) instead of stacking,
    throttled, and silent on errors (KDE: ExcessNotificationGeneration)."""
    import time
    if not shutil.which("notify-send"):
        return
    now = time.monotonic()
    if now - _notif["t"] < NOTIFY_MIN_INTERVAL:
        return
    _notif["t"] = now
    if info["type"] == "item":
        title = "Xianyu — item"
        body  = ("¥" + info["price"] + " — " if "price" in info else "") + info["url"]
    else:
        title = "Xianyu — seller"
        body  = info["url"]
    cmd = ["notify-send", "-t", "5000", "-p", "-a", "xianyu-link", title, body]
    if _notif["id"]:
        cmd[1:1] = ["-r", _notif["id"]]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        nid = r.stdout.strip()
        if nid.isdigit():
            _notif["id"] = nid
    except Exception:
        pass


PRICE_UI_RE = re.compile(r'[¥￥] ?(\d[\d,]*(?:\.\d+)?)')


def _roller_price(tokens):
    """Main price is an animated digit roller: '¥|2|3|3|4|3|4|9|0' = each digit followed
    by its successor (2→3, 3→4, 3→4, 9→0) → 2339. Fall back to plain concatenation."""
    digits = [t for t in tokens if t.isdigit()]
    paired = (len(digits) % 2 == 0 and digits and
              all(int(digits[i + 1]) == (int(digits[i]) + 1) % 10
                  for i in range(0, len(digits), 2)))
    out, i = "", 0
    while i < len(tokens):
        t = tokens[i]
        out += t
        i += 2 if (paired and t.isdigit()) else 1
    return out or None


LOGIN_MARKERS = ("欢迎来到闲鱼", "支付宝登录")
SHOP_MARKERS  = ("共卖出", "严选", "专营", "旗舰店", "专卖店")


_last_page = {"item_id": None, "fp": None}   # fingerprint of the last item page read
_dump_fp   = None                              # fingerprint of the latest dump


def price_from_ui(item_id=None, tries=4):
    """Read (price, seller kind) from the screen.
    Retries if the login popup covers the item, or if the screen still shows the
    previous item's page (same fingerprint) → never returns the previous item's price."""
    import time
    for attempt in range(tries):
        price, login, kind = _price_from_ui_once()
        stale = (item_id and _dump_fp and _last_page["fp"] == _dump_fp
                 and _last_page["item_id"] != item_id)
        if price and not stale:
            _last_page.update(item_id=item_id, fp=_dump_fp)
            return price, kind
        if attempt < tries - 1:
            time.sleep(1)
    if stale:
        print("         (screen still shows the previous item — price skipped)", file=sys.stderr)
    return None, None


def _price_from_ui_once():
    """One uiautomator dump → (price, login_screen_shown, seller_kind)."""
    try:
        subprocess.run(["adb", "shell", "uiautomator", "dump", "/sdcard/ui.xml"],
                       capture_output=True, timeout=8)
        r = subprocess.run(["adb", "shell", "cat", "/sdcard/ui.xml"],
                           capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=5)
    except Exception:
        return None, False, None
    login = any(m in r.stdout for m in LOGIN_MARKERS)
    kind  = "boutique" if any(m in r.stdout for m in SHOP_MARKERS) else None
    descs = [d.replace("&#10;", "\n").replace("\u200b", "")
             for d in re.findall(r'(?:text|content-desc)="([^"]*)"', r.stdout)]
    # Page fingerprint = longest text on screen (item title/description)
    global _dump_fp
    _dump_fp = max(descs, key=len) if descs and not login else None

    def clean(p):
        p = p.replace(",", "")
        return p.rstrip("0").rstrip(".") if "." in p else p

    # 1) Personal listings: '现价1500 , ¥|1500'
    for d in descs:
        m = re.search(r'现价\s*(\d[\d,]*(?:\.\d+)?)', d)
        if m:
            return clean(m.group(1)), login, kind or "particulier"

    # 2) Shop listings: big animated roller '¥|2|3|3|4|3|4|9|0' (one digit per line)
    for d in descs:
        lines = [l.strip() for l in d.split("\n")]
        if "¥" in lines or "￥" in lines:
            i = lines.index("¥") if "¥" in lines else lines.index("￥")
            tokens = []
            for l in lines[i + 1:]:
                if len(l) == 1 and (l.isdigit() or l == "."):
                    tokens.append(l)
                else:
                    break
            p = _roller_price(tokens)
            if p:
                return clean(p), login, "boutique"

    # 3) Fallback: first '¥123' in page order (skip discounts)
    for d in descs:
        if "优惠" in d or "抵" in d:
            continue
        m = PRICE_UI_RE.search(d)
        if m:
            return clean(m.group(1)), login, kind
    return None, login, kind


def get_target_from_ui():
    subprocess.run(["adb", "shell", "uiautomator", "dump", "/sdcard/ui.xml"], capture_output=True)
    r = subprocess.run(["adb", "shell", "cat", "/sdcard/ui.xml"], capture_output=True, text=True, encoding="utf-8", errors="replace")
    for c in re.findall(r'(?:text|content-desc)="(\d{10,15})"', r.stdout):
        if not c.startswith("17"):
            return {"type": "item", "url": ITEM_BASE_URL + c, "item_id": c}
    return None


def get_current_target():
    pid = get_pid()
    r = subprocess.run(
        ["adb", "logcat", "-d", "-t", "10000", "-s", "x-n-x", f"--pid={pid}"],
        capture_output=True, text=True, encoding="utf-8", errors="replace")
    # Scan newest→oldest, merge all lines for the same item to get richest data
    best = None
    for line in reversed(r.stdout.splitlines()):
        result = extract_target(line)
        if not result:
            continue
        if best is None:
            best = result
        elif result.get("item_id") == best.get("item_id"):
            merge(best, result)
        else:
            break  # different item, stop
    if best:
        return best
    print("Logcat buffer empty, trying UI dump...", file=sys.stderr)
    result = get_target_from_ui()
    if result:
        return result
    die("Nothing found. Use --watch: start it first, then open an article or seller page.")


def watch_mode():
    import threading, queue, time
    pid = get_pid()
    print(f"Device:  {DEVICE}")
    print(f"Logs:    {log_stats()}")
    print(f"         {PURGE_HINT}")
    print("\nWatching for Xianyu items & sellers (Ctrl+C to stop)...\n", flush=True)
    seen    = set()
    pending = {}   # item_id -> [info, last_update_time]
    SETTLE  = SETTLE_DELAY

    def flush(info, allow_screenshot=True):
        url = info["url"]
        if url in seen:
            return
        seen.add(url)
        clip = copy_to_clipboard(url)
        display(info, clip, allow_screenshot)
        log_entry(info)
        notify(info)

    def flush_all(allow_screenshot=True):
        for info, _ in list(pending.values()):
            flush(info, allow_screenshot)
        pending.clear()

    # Start reading at the phone's current time: without -T, logcat first replays its
    # whole buffer and the last item of the previous session shows up again.
    r = subprocess.run(["adb", "shell", "date '+%m-%d %H:%M:%S.000'"],   # one string: adb shell re-splits args
                       capture_output=True, text=True, encoding="utf-8", errors="replace")
    since = r.stdout.strip()
    since_args = ["-T", since] if re.fullmatch(r"\d\d-\d\d \d\d:\d\d:\d\d\.000", since) else ["-T", "1"]
    proc = subprocess.Popen(
        ["adb", "logcat", *since_args, "-s", "x-n-x", f"--pid={pid}"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, encoding="utf-8", errors="replace")

    lines = queue.Queue()
    def reader():
        for l in proc.stdout:
            lines.put(l)
        lines.put(None)
    threading.Thread(target=reader, daemon=True).start()

    try:
        while True:
            try:
                line = lines.get(timeout=0.2)
            except queue.Empty:
                line = ""
            if line is None:
                break

            # Flush items whose log lines have settled (screen still shows them)
            now = time.monotonic()
            for iid, (info, t) in list(pending.items()):
                if now - t >= SETTLE:
                    del pending[iid]
                    flush(info)

            if not line:
                continue
            # endEvent = leaving a page (it carries the item we're leaving): never a new capture
            if "endEvent" in line:
                continue
            result = extract_target(line)
            if not result:
                continue

            kind = result["type"]
            url  = result["url"]

            if url in seen:
                continue

            if kind == "seller":
                # Screen already moved on: no screenshot for leftover items
                flush_all(allow_screenshot=False)
                flush(result)
                continue

            item_id = result["item_id"]
            if item_id in pending:
                merge(pending[item_id][0], result)
                pending[item_id][1] = time.monotonic()
            else:
                # Screen already shows the new item: no screenshot for older ones
                flush_all(allow_screenshot=False)
                pending[item_id] = [result, time.monotonic()]

            # Rich data (price or CDN image) → flush immediately
            info = pending[item_id][0]
            if "price" in info or "image" in info:
                del pending[item_id]
                flush(info)

    except KeyboardInterrupt:
        flush_all(allow_screenshot=False)
        proc.terminate()
        print("\nStopped.")


def main():
    import argparse
    if WINDOWS:
        for stream in (sys.stdout, sys.stderr):
            try:
                stream.reconfigure(encoding="utf-8", errors="replace")
            except Exception:
                pass
    global CROP_TOP, CROP_BOTTOM
    ap = argparse.ArgumentParser(description="Extract Xianyu item/seller URLs via ADB.")
    ap.add_argument("-w", "--watch", action="store_true", help="watch continuously")
    ap.add_argument("--last", type=int, metavar="N",
                    help="browse history from the Nth most recent entry (0 = latest): ↑ older, ↓ newer, s split, q quit")
    ap.add_argument("--splitted", "--split", action="store_true",
                    help="with --last: show the screenshot split in 2 halves side by side")
    ap.add_argument("--purge", action="store_true",
                    help="delete ALL history and screenshots (asks for confirmation)")
    ap.add_argument("--purge-older", type=float, metavar="DAYS",
                    help="delete history entries (and screenshots) older than DAYS days")
    ap.add_argument("-y", "--yes", action="store_true", help="with --purge*: don't ask for confirmation")
    ap.add_argument("--top", type=float, default=CROP_TOP,
                    help=f"screenshot crop: start at N%% of height (default {CROP_TOP})")
    ap.add_argument("--bottom", type=float, default=CROP_BOTTOM,
                    help=f"screenshot crop: stop at N%% of height (default {CROP_BOTTOM})")
    args = ap.parse_args()
    if not 0 <= args.top < args.bottom <= 100:
        die("need 0 <= --top < --bottom <= 100")
    CROP_TOP, CROP_BOTTOM = args.top, args.bottom

    if args.purge or args.purge_older is not None:
        purge(None if args.purge else args.purge_older, args.yes)
        return
    if args.last is not None:
        show_last(args.last, args.splitted)
        return

    global DEVICE
    check_adb()
    DEVICE = get_device_name()
    if args.watch:
        watch_mode()
    else:
        info = get_current_target()
        clip = copy_to_clipboard(info["url"])
        display(info, clip)
        log_entry(info)
        notify(info)


if __name__ == "__main__":
    main()
