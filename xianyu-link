#!/usr/bin/env python3

# ── xianyu-link V3.1 - INFO on : https://github.com/pierro78/xianyu-link

from urllib.parse import unquote
from datetime import datetime
from pathlib import Path
import base64, io, json, os, re, subprocess, sys, shutil, tempfile, urllib.request

PACKAGE = "com.taobao.idlefish"

ITEM_ID_RE      = re.compile(r"fleamarket://awesome_detail\?itemId=(\d{9,})")
ITEM_ID_RE_JSON = re.compile(r'"itemId"\s*:\s*"?(\d{9,})"?')
SELLER_ID_RE    = re.compile(r'(?:userId|sellerId)[=:]\s*"?(\d{6,})"?')

ITEM_BASE_URL   = "https://www.goofish.com/item?id="
SELLER_BASE_URL = "https://www.goofish.com/personal?userId="

SELLER_SIGNALS  = ("idle-personal-home", "Page_xySellerHome", "fleamarket://kun", "personal_home")

LOG_FILE = Path.home() / ".local" / "share" / "xianyu-link" / "history.jsonl"
SHOTS_DIR = LOG_FILE.parent / "shots"   # one unsplit screenshot per item: <item_id>.jpg
TMP_DIR  = tempfile.gettempdir()   # /tmp on Linux, %TEMP% on Windows
WINDOWS  = os.name == "nt"

# ── Phone-specific settings (tuned for 2560x1600 8.8" tablet, portrait mode) ──
CROP_TOP         = 5     # % of screen height cut at the top (status bar)   — override: --top N
CROP_BOTTOM      = 95    # % of screen height kept down to (nav buttons)     — override: --bottom N
SCREENSHOT_DELAY = 3     # s between item detection and screen capture
PAGE_LOAD_DELAY  = 1.5   # s to wait before reading the price from the screen
SCREENSHOT_WIDTH = "40%" # imgcat width of the split screenshot (2 halves side by side)
MAINPIC_WIDTH    = "20%" # imgcat width of the CDN fallback image
SETTLE_DELAY     = 0.8   # --watch: s without new log lines before flushing an item


def die(msg):
    print(f"Error: {msg}", file=sys.stderr); sys.exit(1)


def check_adb():
    if not shutil.which("adb"):
        die("adb not found in PATH")
    r = subprocess.run(["adb", "devices"], capture_output=True, text=True, encoding="utf-8", errors="replace")
    lines = [l for l in r.stdout.splitlines() if l.strip() and "List of" not in l]
    if not [l for l in lines if "device" in l and "offline" not in l]:
        die("No ADB device ready. Check cable and USB debugging.")


DEVICE = None   # Android device name, set in main()


def get_device_name():
    """e.g. 'HUAWEI Mate 20 X (EVR-L29, Android 10)'."""
    def prop(name):
        r = subprocess.run(["adb", "shell", "getprop", name], capture_output=True,
                           text=True, encoding="utf-8", errors="replace")
        return r.stdout.strip()
    model  = prop("ro.product.model")
    pretty = (prop("ro.config.marketing_name") or prop("ro.product.marketname")
              or f"{prop('ro.product.brand')} {model}".strip())
    return f"{pretty} ({model}, Android {prop('ro.build.version.release')})"


def get_pid():
    r = subprocess.run(["adb", "shell", f"pidof {PACKAGE}"],
                       capture_output=True, text=True, encoding="utf-8", errors="replace")
    pid = r.stdout.strip().replace("\r", "")
    if not pid:
        die(f"{PACKAGE} not running. Open the app first.")
    return pid.split()[0]


def copy_to_clipboard(text):
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy", text], check=False); return "wl-copy"
    if shutil.which("xclip"):
        subprocess.run(["xclip", "-selection", "clipboard"],
                       input=text.encode(), check=False); return "xclip"
    if WINDOWS:
        subprocess.run(["clip"], input=text.encode(), check=False)   # URLs are ASCII
        return "clip"
    if shutil.which("pbcopy"):   # macOS
        subprocess.run(["pbcopy"], input=text.encode(), check=False); return "pbcopy"
    return None


def _field(pattern, text):
    m = re.search(pattern, text)
    return m.group(1) if m else None


def extract_target(raw_line):
    line = unquote(raw_line)

    # --- Item ---
    item_id = None
    m = ITEM_ID_RE.search(line)
    if m:
        item_id = m.group(1)
    elif "awesome_detail" in line:
        m = ITEM_ID_RE_JSON.search(line)
        if m:
            item_id = m.group(1)

    if item_id:
        info = {"type": "item", "url": ITEM_BASE_URL + item_id, "item_id": item_id}

        price = _field(r'"reserve_price"\s*:\s*"?([\d.]+)"?', line)
        if price:
            info["price"] = price.rstrip("0").rstrip(".")

        ts_raw = _field(r'"publishTime"\s*:\s*"?(\d{10,13})"?', line)
        if ts_raw:
            ts = int(ts_raw)
            if ts > 1e12: ts //= 1000
            info["published"] = datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M")

        seller_id = _field(r'"sellerId"\s*:\s*"(\d+)"', line)
        if seller_id:
            info["seller_url"] = SELLER_BASE_URL + seller_id

        query = _field(r'"q"\s*:\s*"([^"]+)"', line)
        if query:
            info["query"] = query

        idx = _field(r'"index"\s*:\s*"?(\d+)"?', line)
        if idx:
            info["index"] = idx

        image = _field(r'"mainPic"\s*:\s*"([^"]+)"', line)
        if image:
            info["image"] = image

        return info

    # --- Seller ---
    if any(sig in line for sig in SELLER_SIGNALS):
        m = SELLER_ID_RE.search(line)
        if m:
            return {"type": "seller", "url": SELLER_BASE_URL + m.group(1), "user_id": m.group(1)}

    return None


def merge(base, new):
    """Add fields from new into base without overwriting existing ones."""
    for k, v in new.items():
        if v is not None and k not in base:
            base[k] = v


def display(info, clip_tool=None, allow_screenshot=True):
    kind = info["type"]
    url  = info["url"]
    clip_note = f"  → copied ({clip_tool})" if clip_tool else ""
    info["seen_at"] = datetime.now().isoformat(timespec="seconds")
    if DEVICE:
        info["device"] = DEVICE

    if kind == "item":
        print(f"[item]   {url}{clip_note}", flush=True)
        delay = SCREENSHOT_DELAY
        if "price" not in info and allow_screenshot:
            # Price is cut off from logcat (4 KB line limit) → read it from the screen
            import time
            t0 = time.monotonic()
            time.sleep(PAGE_LOAD_DELAY)   # let the item page load
            price, seller_kind = price_from_ui(info.get("item_id"))
            if price:
                info["price"] = price
            if seller_kind:
                info["seller_kind"] = seller_kind
            delay = max(0, SCREENSHOT_DELAY - (time.monotonic() - t0))
        print_details(info)
        shot = show_image(info.get("image"), allow_screenshot, delay, info.get("item_id"))
        if shot:
            info["screenshot"] = shot
    else:
        print(f"[seller] {url}{clip_note}")
        print_details(info)

    print(flush=True)


def print_details(info, device=False):
    """Compact: 2 lines max under the URL.
       ¥ 2339 (boutique) · published 2026-11-14 10:43 · captured 2026-11-16 22:20:21
       seller https://…  · "matepad mini" #2  · HUAWEI Mate 20 X"""
    a = []
    if "price" in info:
        a.append(f"¥ {info['price']}" + (f" ({info['seller_kind']})" if "seller_kind" in info else ""))
    elif "seller_kind" in info:
        a.append(f"({info['seller_kind']})")
    if "published" in info: a.append(f"published {info['published']}")
    if "seen_at"   in info: a.append(f"captured {info['seen_at'].replace('T', ' ')}")
    b = []
    if info.get("type") == "item" and "seller_url" in info:
        b.append(f"seller {info['seller_url']}")
    if "query" in info:
        b.append(f"\"{info['query']}\"" + (f" #{info['index']}" if "index" in info else ""))
    if device and "device" in info:
        b.append(info["device"].split(" (")[0])
    for parts in (a, b):
        if parts:
            print("         " + "  ·  ".join(parts))
    sys.stdout.flush()


def log_entry(info):
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    entry = {"seen_at": datetime.now().isoformat(timespec="seconds"), **info}
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


def _imgcat(path, width=MAINPIC_WIDTH):
    if shutil.which("wezterm"):
        subprocess.run(["wezterm", "imgcat", "--width", width, path], check=False)
    else:
        data = open(path, "rb").read()
        b64  = base64.b64encode(data).decode()
        sys.stdout.write(f"\033]1337;File=inline=1;width={width};preserveAspectRatio=1:{b64}\a\n")
        sys.stdout.flush()


def _split_halves(src):
    """Split a portrait image in 2 equal halves placed side by side → temp jpg path."""
    from PIL import Image
    img = Image.open(src).convert("RGB")
    cw, ch = img.size
    half = ch // 2
    gap  = 10
    combined = Image.new("RGB", (cw * 2 + gap, half), (255, 255, 255))
    combined.paste(img.crop((0, 0, cw, half)), (0, 0))
    combined.paste(img.crop((0, half, cw, half * 2)), (cw + gap, 0))
    out = os.path.join(TMP_DIR, "xianyu_sc_split.jpg")
    combined.save(out, "JPEG", quality=85)
    return out


def _screenshot_crop(delay=SCREENSHOT_DELAY, item_id=None):
    """Capture the phone screen, crop status/nav bars, save it (unsplit) → path."""
    try:
        import time; time.sleep(delay)
        from PIL import Image
        img = None
        for attempt in range(3):
            # Empty capture when the login popup (secure window) is on top → retry
            r = subprocess.run(["adb", "exec-out", "screencap", "-p"],
                               capture_output=True, timeout=10)
            try:
                img = Image.open(io.BytesIO(r.stdout)).convert("RGB")
                break
            except Exception:
                time.sleep(1)
        if img is None:
            return None
        w, h = img.size
        cropped = img.crop((0, int(h * CROP_TOP / 100), w, int(h * CROP_BOTTOM / 100)))
        if item_id:
            SHOTS_DIR.mkdir(parents=True, exist_ok=True)
            out = str(SHOTS_DIR / f"{item_id}.jpg")
        else:
            out = os.path.join(TMP_DIR, "xianyu_sc_crop.jpg")
        cropped.save(out, "JPEG", quality=85)
        return out
    except Exception:
        return None


def show_mainpic(url):
    try:
        if url.startswith("//"):
            url = "https:" + url
        with urllib.request.urlopen(url, timeout=10) as r:
            data = r.read()
        from PIL import Image
        img = Image.open(io.BytesIO(data)).convert("RGB")
        img.thumbnail((800, 800))
        tmp = os.path.join(TMP_DIR, "xianyu_mainpic.jpg")
        img.save(tmp, "JPEG", quality=85)
        _imgcat(tmp)
    except Exception as e:
        print(f"         (image download failed: {e})", file=sys.stderr)


def show_image(url, allow_screenshot=True, delay=SCREENSHOT_DELAY, item_id=None):
    """Display the item: phone screenshot split in 2 halves side by side.
    Falls back to the CDN mainPic if the screen can't be captured (or already shows another page).
    Returns the saved (unsplit) screenshot path, if any."""
    if not sys.stdout.isatty():
        return None
    if allow_screenshot:
        path = _screenshot_crop(delay, item_id)
        if path:
            try:
                _imgcat(_split_halves(path), SCREENSHOT_WIDTH)
            except Exception:
                _imgcat(path, MAINPIC_WIDTH)
            return path
    if url:
        show_mainpic(url)
    return None


def _load_history():
    try:
        with open(LOG_FILE, encoding="utf-8") as f:
            return [json.loads(l) for l in f if l.strip()]
    except FileNotFoundError:
        die(f"no history yet ({LOG_FILE})")


def show_entry(info, split, copy=True):
    clip = copy_to_clipboard(info["url"]) if copy else None
    clip_note = f"  → copied ({clip})" if clip else ""
    print(f"[{info['type']}]".ljust(9) + f"{info['url']}{clip_note}")
    print_details(info, device=True)
    if info["type"] == "item":
        shot = info.get("screenshot")
        if not sys.stdout.isatty():
            pass   # no inline images when piped
        elif shot and os.path.exists(shot):
            if split:
                _imgcat(_split_halves(shot), SCREENSHOT_WIDTH)
            else:
                _imgcat(shot, MAINPIC_WIDTH)
        elif info.get("image"):
            print("         (no screenshot saved, showing CDN image)")
            show_mainpic(info["image"])
        else:
            print("         (no screenshot saved for this entry)")
    print(flush=True)


def _human(n):
    for unit in ("o", "Ko", "Mo", "Go"):
        if n < 1024 or unit == "Go":
            return f"{n:.0f} {unit}" if unit == "o" else f"{n:.1f} {unit}"
        n /= 1024


def log_stats():
    """→ 'N captures (I items, S sellers, P screenshots) — X Mo' for the startup banner."""
    entries = []
    if LOG_FILE.exists():
        with open(LOG_FILE, encoding="utf-8") as f:
            entries = [json.loads(l) for l in f if l.strip()]
    shots = list(SHOTS_DIR.glob("*.jpg")) if SHOTS_DIR.exists() else []
    size  = (LOG_FILE.stat().st_size if LOG_FILE.exists() else 0) + sum(p.stat().st_size for p in shots)
    items = sum(1 for e in entries if e.get("type") == "item")
    return (f"{len(entries)} captures ({items} items, {len(entries) - items} sellers, "
            f"{len(shots)} screenshots) — {_human(size)} in {LOG_FILE.parent}")


def purge(days=None, yes=False):
    """Delete history entries (all, or older than `days`) and their unreferenced screenshots."""
    from datetime import timedelta
    entries = _load_history() if LOG_FILE.exists() else []
    if days is None:
        keep = []
        what = "ALL history and screenshots"
    else:
        cutoff = (datetime.now() - timedelta(days=days)).isoformat(timespec="seconds")
        keep = [e for e in entries if e.get("seen_at", "") >= cutoff]
        what = f"{len(entries) - len(keep)} entries older than {days} days (+ their screenshots)"
    print(f"Before: {log_stats()}")
    if not yes:
        try:
            if input(f"Delete {what}? [y/N] ").strip().lower() not in ("y", "yes", "o", "oui"):
                print("Cancelled."); return
        except EOFError:
            print("Cancelled."); return
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG_FILE, "w", encoding="utf-8") as f:
        for e in keep:
            f.write(json.dumps(e, ensure_ascii=False) + "\n")
    used = {os.path.abspath(e["screenshot"]) for e in keep if e.get("screenshot")}
    if SHOTS_DIR.exists():
        for shot in SHOTS_DIR.glob("*.jpg"):
            if os.path.abspath(shot) not in used:
                shot.unlink()
    print(f"After:  {log_stats()}")


