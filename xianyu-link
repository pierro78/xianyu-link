def die(msg):
    print(f"Error: {msg}", file=sys.stderr); sys.exit(1)


def check_adb():
    if not shutil.which("adb"):
        die("adb not found in PATH")
    r = subprocess.run(["adb", "devices"], capture_output=True, text=True, encoding="utf-8", errors="replace")
    lines = [l for l in r.stdout.splitlines() if l.strip() and "List of" not in l]
    if not [l for l in lines if "device" in l and "offline" not in l]:
        die("No ADB device ready. Check cable and USB debugging.")


DEVICE = None   # Android device name, set in main()


def get_device_name():
    """e.g. 'HUAWEI Mate 20 X (EVR-L29, Android 10)'."""
    def prop(name):
        r = subprocess.run(["adb", "shell", "getprop", name], capture_output=True,
                           text=True, encoding="utf-8", errors="replace")
        return r.stdout.strip()
    model  = prop("ro.product.model")
    pretty = (prop("ro.config.marketing_name") or prop("ro.product.marketname")
              or f"{prop('ro.product.brand')} {model}".strip())
    return f"{pretty} ({model}, Android {prop('ro.build.version.release')})"


def get_pid():
    r = subprocess.run(["adb", "shell", f"pidof {PACKAGE}"],
                       capture_output=True, text=True, encoding="utf-8", errors="replace")
    pid = r.stdout.strip().replace("\r", "")
    if not pid:
        die(f"{PACKAGE} not running. Open the app first.")
    return pid.split()[0]


def copy_to_clipboard(text):
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy", text], check=False); return "wl-copy"
    if shutil.which("xclip"):
        subprocess.run(["xclip", "-selection", "clipboard"],
                       input=text.encode(), check=False); return "xclip"
    if WINDOWS:
        subprocess.run(["clip"], input=text.encode(), check=False)   # URLs are ASCII
        return "clip"
    if shutil.which("pbcopy"):   # macOS
        subprocess.run(["pbcopy"], input=text.encode(), check=False); return "pbcopy"
    return None


def _field(pattern, text):
    m = re.search(pattern, text)
    return m.group(1) if m else None


def extract_target(raw_line):
    line = unquote(raw_line)

    # --- Item ---
    item_id = None
    m = ITEM_ID_RE.search(line)
    if m:
        item_id = m.group(1)
    elif "awesome_detail" in line:
        m = ITEM_ID_RE_JSON.search(line)
        if m:
            item_id = m.group(1)

    if item_id:
        info = {"type": "item", "url": ITEM_BASE_URL + item_id, "item_id": item_id}

        price = _field(r'"reserve_price"\s*:\s*"?([\d.]+)"?', line)
        if price:
            info["price"] = price.rstrip("0").rstrip(".")

        ts_raw = _field(r'"publishTime"\s*:\s*"?(\d{10,13})"?', line)
        if ts_raw:
            ts = int(ts_raw)
            if ts > 1e12: ts //= 1000
            info["published"] = datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M")

        seller_id = _field(r'"sellerId"\s*:\s*"(\d+)"', line)
        if seller_id:
            info["seller_url"] = SELLER_BASE_URL + seller_id

        query = _field(r'"q"\s*:\s*"([^"]+)"', line)
        if query:
            info["query"] = query

        idx = _field(r'"index"\s*:\s*"?(\d+)"?', line)
        if idx:
            info["index"] = idx

        image = _field(r'"mainPic"\s*:\s*"([^"]+)"', line)
        if image:
            info["image"] = image

        return info

    # --- Seller ---
    if any(sig in line for sig in SELLER_SIGNALS):
        m = SELLER_ID_RE.search(line)
        if m:
            return {"type": "seller", "url": SELLER_BASE_URL + m.group(1), "user_id": m.group(1)}

    return None


def merge(base, new):
    """Add fields from new into base without overwriting existing ones."""
    for k, v in new.items():
        if v is not None and k not in base:
            base[k] = v


# --watch sets this: True once the logs show the user has left the item being processed
moved_on = lambda: False


def _wait(seconds):
    """Sleep, but stop early if the user moved to another page → True if moved on."""
    import time
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        if moved_on():
            return True
        time.sleep(0.2)
    return moved_on()


_seller_kinds = None   # seller URL → 'boutique'/'particulier', from seller pages (more reliable)


def seller_kinds():
    """Seller types already read on their profile page (history + this session)."""
    global _seller_kinds
    if _seller_kinds is None:
        _seller_kinds = {}
        try:
            with open(LOG_FILE, encoding="utf-8") as f:
                for l in f:
                    e = json.loads(l)
                    k = e.get("seller_kind")
                    if e.get("type") == "seller" and k:
                        if not e.get("shop_badge") and not k.endswith("?"):
                            k += "?"   # older entries: no proof recorded → a guess
                        _seller_kinds[e["url"]] = k
        except (FileNotFoundError, ValueError):
            pass
    return _seller_kinds


def display(info, clip_tool=None, allow_screenshot=True):
    kind = info["type"]
    url  = info["url"]
    clip_note = f"  → copied ({clip_tool})" if clip_tool else ""
    info["seen_at"] = datetime.now().isoformat(timespec="seconds")
    if DEVICE:
        info["device"] = DEVICE

    if kind == "item":
        print(f"[item]   {url}{clip_note}", flush=True)
        delay = SCREENSHOT_DELAY
        if "price" not in info and allow_screenshot:
            # Price is cut off from logcat (4 KB line limit) → read it from the screen
            import time
            t0 = time.monotonic()
            if _wait(PAGE_LOAD_DELAY):   # let the item page load (unless already left)
                price, seller_kind = None, None
            else:
                price, seller_kind = price_from_ui(info.get("item_id"))
            if price:
                info["price"] = price
            if seller_kind:
                info["seller_kind"] = seller_kind
            delay = max(0, SCREENSHOT_DELAY - (time.monotonic() - t0))
        if info.get("seller_url") in seller_kinds():
            # the seller's profile page already told us (e.g. 持证经营 = licensed business)
            info["seller_kind"] = seller_kinds()[info["seller_url"]]
        if moved_on():
            allow_screenshot = False   # screen already shows another page
            print("         (left the item before capture — no price/screenshot)")
        print_details(info)
        shot = show_image(info.get("image"), allow_screenshot, delay, info.get("item_id"))
        if shot:
            info["screenshot"] = shot
    else:
        print(f"[seller] {url}{clip_note}", flush=True)
        import time
        t0 = time.monotonic()
        if allow_screenshot and not _wait(PAGE_LOAD_DELAY):
            merge(info, seller_from_ui())
            if info.get("seller_kind"):
                seller_kinds()[url] = info["seller_kind"]
        delay = max(0, SCREENSHOT_DELAY - (time.monotonic() - t0))
        if moved_on():
            allow_screenshot = False
            print("         (left the seller before capture — no profile/screenshot)")
        print_details(info)
        shot = show_image(None, allow_screenshot, delay, f"seller_{info.get('user_id')}")
        if shot:
            info["screenshot"] = shot

    print(flush=True)


